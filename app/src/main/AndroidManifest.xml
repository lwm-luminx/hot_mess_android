<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pair me up: scanning your match's code when you meet. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Venue beacons. Android 12 and later ask for nearby devices; older versions use location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- The Facebook SDK signs in through the Facebook app and nothing else, so it gets no advertising id. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />

    <application
        android:name=".HotMessApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.HotMess"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- hotmess://venues/<id>, hotmess://events/<id>, hotmess://people/<id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hotmess" />
            </intent-filter>

            <!-- Shared links. Verifying them needs assetlinks.json on hotmess.social. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="hotmess.social" />
                <data android:pathPrefix="/venues/" />
                <data android:pathPrefix="/events/" />
                <data android:pathPrefix="/people/" />
                <data android:pathPrefix="/posts/" />
                <!-- A Ping, from a push or a link texted from the send sheet (with its invitation in `e`). -->
                <data android:pathPrefix="/pings/" />
                <!-- A venue's short link (a TV's QR code), followed through the site's redirect (ShortLink). -->
                <data android:pathPrefix="/v/" />
                <!-- A locale's chat room (a venue's, /venues/<id>/chat, is under /venues/). -->
                <data android:pathPattern="/locales/.*/chat" />
            </intent-filter>

            <!-- Facebook's login dialog redirects to fbconnect://cct.<application id> with a code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fbconnect" android:host="cct.${applicationId}" />
            </intent-filter>

            <!-- Sign in with Apple: the API hands Apple's web sign-in back here, to this package only (AppleWebSignIn). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="audiencekit-apple" android:host="callback" />
            </intent-filter>

            <!-- A Business-type Facebook app's dialog redirects to fb<app id>://authorize/ instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fb${facebookAppId}" android:host="authorize" />
            </intent-filter>
        </activity>

        <!--
            The Facebook SDK, for sign-in through the Facebook app. FacebookAppSignIn starts it, only in builds with a
            client token, so its own start-up provider goes. Its Custom Tab login goes too: without the Facebook app,
            MainActivity opens the dialog itself, and that activity would take the same fbconnect:// redirect.
        -->
        <provider
            android:name="com.facebook.internal.FacebookInitProvider"
            android:authorities="${applicationId}.FacebookInitProvider"
            tools:node="remove" />
        <activity android:name="com.facebook.CustomTabActivity" tools:node="remove" />
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="false" />

        <!-- Google Pay in Stripe's payment sheet, for paying cover. -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />

        <service
            android:name=".push.HotMessMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- A push Android posts itself (the app in the background) goes in the channel the API names, or else
             this one, with the app's monochrome icon instead of a blank square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher_monochrome" />
    </application>

    <queries>
        <!-- A browser with Custom Tabs, for Facebook's login dialog. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Messenger, for opening a friend's thread. -->
        <package android:name="com.facebook.orca" />
        <!-- Velvet and Backstage, which Me opens for venue and talent managers. -->
        <package android:name="com.audiencekit.Velvet" />
        <package android:name="com.audiencekit.Backstage" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>
</manifest>
